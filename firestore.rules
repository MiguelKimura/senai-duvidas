rules_version = '2';

// Security Rules do Firestore — ESTADO ATUAL, DELIBERADAMENTE INSEGURO.
//
// Este arquivo NÃO endurece nada. Ele descreve, por escrito e de forma
// testável, o que a aplicação da v0.1.0 precisa para funcionar hoje. Apertar as
// regras aqui quebraria o app em produção antes das tasks que o adaptam — e o
// app roda em laboratório, com turma em aula.
//
// Por que versionar regras frouxas em vez de não versionar nada: sem baseline
// não há como provar que a task 03 apertou. Cada permissão excessiva abaixo
// tem um teste em `tests/rules/firestore.rules.test.js` que a demonstra
// explorada. Quando a task 03 endurecer, esses testes invertem de sinal — de
// "consegue" para "é negado" — e é essa inversão que comprova a correção.
service cloud.firestore {
  match /databases/{database}/documents {

    // ----------------------------------------------------------------------
    // Funções auxiliares (task 01).
    //
    // A task 03 vai reusá-las para escopar `chamados` e `chat` por sala. Aqui
    // elas valem só em `usuarios`, que é onde o papel do usuário é gravado.
    // ----------------------------------------------------------------------

    /// Existe sessão do Firebase Auth.
    function ehAutenticado() {
      return request.auth != null;
    }

    /// O documento pertence a quem está escrevendo.
    function ehDono(uid) {
      return ehAutenticado() && request.auth.uid == uid;
    }

    /// E-mail do token, normalizado como o id usado em `autorizados`.
    ///
    /// Vem do token, nunca do payload: o corpo da requisição é escolhido pelo
    /// cliente, e o token é assinado pelo Firebase.
    function emailDoToken() {
      return ehAutenticado() && request.auth.token.email != null
        ? request.auth.token.email.lower()
        : '';
    }

    /// Está em `autorizados/{email}` com `Tipo: "professor"`.
    ///
    /// `autorizados` é mantida à mão no console e tem escrita negada abaixo,
    /// então é a única autoridade que o cliente não consegue forjar.
    function ehProfessor() {
      return ehAutenticado()
        && exists(/databases/$(database)/documents/autorizados/$(emailDoToken()))
        && get(/databases/$(database)/documents/autorizados/$(emailDoToken()))
             .data.Tipo.lower() == 'professor';
    }

    /// A escrita está tentando marcar o documento como professor.
    function gravaTipoProfessor() {
      return request.resource.data.keys().hasAny(['tipo'])
        && request.resource.data.tipo is string
        && request.resource.data.tipo.lower() == 'professor';
    }

    // Chamados: coleção global, sem escopo de sala e sem dono.
    //
    // A interface mostra "Excluir" só para o autor, mas isso é decoração de
    // front-end: nada no servidor confere autoria. Qualquer cliente com a
    // config do projeto apaga o chamado de qualquer aluno.
    //
    // TODO(task-03): endurecer. Escopar por `salaId`, exigir request.auth,
    // restringir delete ao autor ou ao professor da sala, e validar os campos
    // na escrita.
    match /chamados/{chamadoId} {
      allow read, create, update, delete: if true;
    }

    // Chat: mesma história, e pior — o comando `!clear` apaga a conversa
    // inteira da turma, e qualquer aluno pode dispará-lo.
    //
    // TODO(task-03): endurecer. Escopar por sala, exigir request.auth e
    // restringir a exclusão em massa ao professor (AC-CHAT-*, task 06).
    match /chat/{mensagemId} {
      allow read, create, update, delete: if true;
    }

    // Usuários: criado por `Cadastro` e por `services/perfilUsuario.js` logo
    // após a autenticação.
    //
    // ENDURECIDO pela task 01. Era `if true`, e era ali que a escalada de
    // privilégio acontecia: o cliente escolhia o próprio `tipo` e o servidor
    // aceitava. Agora só o dono escreve o próprio documento, e só vira
    // professor quem `autorizados` confirma (AC-AUTH-07, AC-SEC-03).
    //
    // A leitura exige sessão porque a coleção guarda nome e e-mail de aluno
    // menor de idade. Os dois únicos leitores do app — `garantirPerfil` e a
    // resolução de papel — já rodam autenticados.
    //
    // TODO(task-03): restringir a leitura ao próprio documento e aos
    // professores da sala, quando `salas/{id}/membros` existir. Hoje qualquer
    // pessoa autenticada lê qualquer perfil.
    match /usuarios/{uid} {
      allow read: if ehAutenticado();
      allow create, update: if ehDono(uid) && (!gravaTipoProfessor() || ehProfessor());
      // TODO(task-01): a exclusão ainda é livre. Próximo ciclo.
      allow delete: if true;
    }

    // Autorizados: a lista que diz quem pode se cadastrar como professor.
    // `utils/permissoes.js` a lê ANTES de existir sessão, então a leitura
    // precisa ser pública enquanto o fluxo de cadastro for esse.
    //
    // Escrita nunca: esta coleção é mantida à mão no console. Esta é a única
    // restrição que já vale hoje, e ela precisa continuar valendo.
    //
    // TODO(task-03): endurecer a leitura, movendo a checagem de professor para
    // um custom claim — aí esta coleção deixa de ser lida pelo cliente.
    match /autorizados/{email} {
      allow read: if true;
      allow write: if false;
    }

    // Nada mais existe no banco. Negar o resto evita que uma coleção nova
    // nasça aberta por descuido.
    match /{documento=**} {
      allow read, write: if false;
    }
  }
}
