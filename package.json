{
  "name": "projeto-duvidas-senai",
  "version": "0.6.0",
  "private": true,
  "dependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^13.5.0",
    "dompurify": "^3.4.15",
    "firebase": "^11.4.0",
    "marked": "^13.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.5.0",
    "react-router-dom": "^6.29.0",
    "react-scripts": "5.0.1",
    "styled-components": "^6.1.16",
    "web-vitals": "^2.1.4",
    "yocto-queue": "^1.2.0"
  },
  "scripts": {
    "start": "cross-env PORT=3000 react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test --roots src --roots scripts",
    "test:ci": "cross-env CI=true react-scripts test --watchAll=false --coverage --roots src --roots scripts",
    "test:fusos": "cross-env CI=true TZ=UTC react-scripts test --watchAll=false --roots src --roots scripts && cross-env CI=true TZ=America/New_York react-scripts test --watchAll=false --roots src --roots scripts",
    "test:rules": "firebase emulators:exec --project demo-senai-duvidas --only firestore,storage \"jest --config jest.rules.config.js\"",
    "emulators": "firebase emulators:start --project demo-senai-duvidas",
    "lint": "eslint \"src/**/*.{js,jsx}\" \"tests/**/*.js\" \"scripts/**/*.js\" --max-warnings=0",
    "format": "prettier --write \"src/**/*.{js,jsx,css}\" \"tests/**/*.js\" \"scripts/**/*.js\"",
    "eject": "react-scripts eject",
    "changelog": "node scripts/gerarChangelog.js"
  },
  "jest": {
    "testMatch": [
      "**/src/**/__tests__/**/*.{js,jsx}",
      "**/src/**/*.{spec,test}.{js,jsx}",
      "**/scripts/__tests__/**/*.js"
    ],
    "collectCoverageFrom": [
      "src/**/*.{js,jsx}",
      "!src/index.js",
      "!src/reportWebVitals.js",
      "!src/setupTests.js",
      "!src/test-utils/**",
      "!src/__mocks__/**"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 80,
        "branches": 75,
        "statements": 80,
        "functions": 80
      }
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "firebase-tools": "^13.0.0",
    "js-yaml": "^3.14.1",
    "prettier": "^3.4.2",
    "undici": "^6.28.1"
  }
}
